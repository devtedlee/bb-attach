#!/usr/bin/env python3
# bb-attach — Bitbucket Cloud 이미지·영상(영상은 GIF로 변환) 업로더 (sudosubin/gh-attach 의 Bitbucket 판).
#
# 브라우저 세션 쿠키로 웹 UI가 쓰는 비공개 엔드포인트를 호출해 이미지를 올리고,
# PR 설명·댓글에 그대로 박을 수 있는 URL을 반환한다. 공개 REST API(api.bitbucket.org)로는
# PR-scoped 첨부가 불가능하므로 이 경로가 유일한 gh-attach 등가물이다.
#
# ponytail: 비공개 엔드포인트 /xhr/{ws}/{repo}/image-upload/ 에 의존한다 —
#   Atlassian이 바꾸면 깨진다. 응답에 href 없으면 즉시 실패시켜 '조용한 깨짐'을 막는다.
#   업그레이드 경로: 공개 PR-attachment API가 나오면 그쪽으로 교체.
# ponytail: image-upload는 이미지만 받아(영상은 400 "File must be an image.") 영상은 GIF 변환 후 올린다 — 사용자 결정, 원본 mp4는 올리지 않는다.
#
# Usage:
#   bb-attach img.png [demo.mp4 ...]         # URL 출력 (영상은 GIF로 변환 후 업로드)
#   bb-attach -m img.png                     # ![name](url) 마크다운 출력
#   bb-attach --json img.png                 # JSON 출력
#   bb-attach --repo ws/repo img.png         # repo 명시 (기본: git origin 에서 추론)
#   bb-attach --browser firefox img.png      # 쿠키 소스 브라우저 (기본 chrome)
import argparse, json, mimetypes, os, re, shutil, subprocess, sys, tempfile, urllib.error, urllib.request, uuid

ENDPOINT = "https://bitbucket.org/xhr/{ws}/{repo}/image-upload/"


def resolve_repo(arg):
    if arg:
        if "/" not in arg:
            sys.exit("--repo 는 workspace/repo 형식")
        ws, repo = arg.split("/", 1)
        return ws, repo
    try:
        url = subprocess.check_output(
            ["git", "remote", "get-url", "origin"], text=True, stderr=subprocess.DEVNULL
        ).strip()
    except Exception:
        sys.exit("git origin 없음 — --repo ws/repo 로 지정")
    m = re.search(r"bitbucket\.org[:/]([^/]+)/(.+?)(?:\.git)?/?$", url)
    if not m:
        sys.exit(f"bitbucket repo 추론 실패({url}) — --repo ws/repo 로 지정")
    return m.group(1), m.group(2)


def get_cookies(browser):
    try:
        import browser_cookie3 as bc
    except ImportError:
        sys.exit("browser_cookie3 미설치 — `pip3 install --user browser-cookie3` 후 재시도")
    fn = {"chrome": bc.chrome, "firefox": bc.firefox, "safari": bc.safari,
          "edge": bc.edge, "brave": bc.brave}[browser]
    jar = fn(domain_name="bitbucket.org")
    cookies = {c.name: c.value for c in jar}
    if "csrftoken" not in cookies or "bb_session" not in cookies:
        sys.exit(f"{browser}에서 bitbucket.org 세션 쿠키 없음 — 브라우저에서 로그인 상태인지 확인")
    return cookies


VIDEO_EXT = (".mp4", ".mov", ".webm", ".mkv", ".m4v")


def is_video(path):
    return (mimetypes.guess_type(path)[0] or "").startswith("video/") or path.lower().endswith(VIDEO_EXT)


def to_gif(path, tmp):
    if not shutil.which("ffmpeg"):
        raise RuntimeError("ffmpeg 필요 — brew install ffmpeg")
    gif = os.path.join(tmp, os.path.splitext(os.path.basename(path))[0] + ".gif")
    vf = "fps=8,scale='min(1100,iw)':-1:flags=lanczos"
    pal = os.path.join(tmp, "palette.png")
    base = ["ffmpeg", "-v", "error", "-y", "-i", path]
    try:
        subprocess.run(base + ["-vf", vf + ",palettegen", pal], check=True, capture_output=True, text=True)
        subprocess.run(base + ["-i", pal, "-lavfi", vf + "[x];[x][1:v]paletteuse", gif],
                       check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"GIF 변환 실패: {e.stderr.strip()[:300]}")
    return gif


def upload(ws, repo, path, cookies):
    if not os.path.isfile(path):
        raise RuntimeError(f"파일 없음: {path}")
    if is_video(path):
        with tempfile.TemporaryDirectory() as tmp:
            return upload(ws, repo, to_gif(path, tmp), cookies)
    fname = os.path.basename(path)
    ctype = mimetypes.guess_type(fname)[0] or "application/octet-stream"
    with open(path, "rb") as f:
        data = f.read()
    boundary = "----bbattach" + uuid.uuid4().hex
    body = b"".join([
        f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{fname}"\r\n'.encode(),
        f"Content-Type: {ctype}\r\n\r\n".encode(),
        data,
        f"\r\n--{boundary}--\r\n".encode(),
    ])
    req = urllib.request.Request(
        ENDPOINT.format(ws=ws, repo=repo),
        data=body,
        method="POST",
        headers={
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "Cookie": "; ".join(f"{k}={v}" for k, v in cookies.items()),
            "X-CSRFToken": cookies["csrftoken"],
            "X-Requested-With": "XMLHttpRequest",
            "X-Bitbucket-Frontend": "frontbucket",
            "Origin": "https://bitbucket.org",
            "Referer": f"https://bitbucket.org/{ws}/{repo}",
        },
    )
    try:
        raw = urllib.request.urlopen(req).read()
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:300]
        raise RuntimeError(f"업로드 실패 HTTP {e.code} — {detail}\n(세션 만료 시 브라우저에서 재로그인)")
    try:
        out = json.loads(raw)
    except ValueError:
        raise RuntimeError(f"응답이 JSON 아님(엔드포인트 변경 의심): {raw[:200]!r}")
    href = out.get("href")
    if not href:  # ponytail: 엔드포인트 스펙 변경 시 조용히 잘못된 URL 뱉는 것 방지
        raise RuntimeError(f"응답에 href 없음(엔드포인트 변경 의심): {out}")
    return href, out.get("filename", fname)


def main():
    ap = argparse.ArgumentParser(description="Bitbucket Cloud 이미지·영상(영상은 GIF로 변환) 첨부 업로더 (gh-attach 의 bb 판)")
    ap.add_argument("files", nargs="+", help="업로드할 이미지·영상 파일 (영상은 GIF로 변환)")
    ap.add_argument("--repo", help="workspace/repo (기본: git origin 에서 추론)")
    ap.add_argument("--browser", default="chrome",
                    choices=["chrome", "firefox", "safari", "edge", "brave"],
                    help="쿠키 소스 브라우저 (기본 chrome)")
    ap.add_argument("-m", "--markdown", action="store_true", help="![name](url) 형식으로 출력")
    ap.add_argument("--json", action="store_true", help="JSON 배열로 출력")
    a = ap.parse_args()

    ws, repo = resolve_repo(a.repo)
    cookies = get_cookies(a.browser)
    results, failed = [], False
    for p in a.files:
        try:
            r = dict(zip(("href", "filename"), upload(ws, repo, p, cookies)), file=p)
            if is_video(p):
                r["converted_from"] = p
            results.append(r)
            if not a.json:
                print(f"![{r['filename']}]({r['href']})" if a.markdown else r["href"])
        except RuntimeError as e:
            failed = True
            results.append({"file": p, "error": str(e)})
            print(f"{p}: {e}", file=sys.stderr)
    if a.json:
        print(json.dumps(results, ensure_ascii=False, indent=2))
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
